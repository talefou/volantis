//=============================//
// 自定义样式 提供可复用的样式  //
//============================//

//======================================//
// 页脚自定义响应式处理
.footerMax560
  @media screen and (max-width: 560px)
    display none

.footerMax490
  @media screen and (max-width: 490px)
    display none

.footerMax380
  @media screen and (max-width: 380px)
    display none
//======================================//


//======================================//
// 禁止选中
.not-select,
figcaption,
footer,
section,
details summary,
.new-meta-box,
.prev-next,
.atk-main-editor,
.atk-list-header,
.nav-tabs
  -webkit-touch-callout none
  -webkit-user-select none
  -khtml-user-select none
  -moz-user-select none
  -ms-user-select none
  user-select none
  & p,
  & span
    cursor: $default
  &.default-cursor
    cursor: $default !important
  & a span
    cursor: $pointer !important
.allow-select
  -webkit-touch-callout all
  -webkit-user-select all
  -khtml-user-select all
  -moz-user-select all
  -ms-user-select all
  user-select all
//======================================//


//======================================//
// 文章页导航栏标题居中、加粗等
.l_header #wrapper.sub .nav-sub .title
  margin: 0 auto
  font-size: 1.5rem
  overflow: hidden
  font-weight: 800 !important
  @media screen and (max-width: $device-mobile)
    margin: unset !important
    font-size: 1rem !important
//======================================//


//======================================//
// 自定义淡入淡出
.content-in
  animation content-fadeIn 1s ease-in-out
@keyframes content-fadeIn
  0%
    opacity 0
    filter blur(10px)
    transform: scale(0.9)
  50%
    opacity 0
    filter blur(10px)
    transform: scale(0.95)
  100%
    opacity 1
    filter blur(0px)
    transform: scale(1)
@keyframes content-fadeIn-2s
  0%
    opacity 0
    filter blur(10px)
  50%
    opacity 0
    filter blur(10px)
  70%
    opacity 0
    filter blur(10px)
  100%
    opacity 1
    filter blur(0px)
//======================================//


//======================================//
// HTTP 451 错误
.note.quote.cus451:after
  @media screen and (min-width: 900px)
    background: url("data:image/svg+xml;base64,")
    content: " ";
    height: 160px;
    right: 5px;
    top: 5px;
    width: 160px;
    position: absolute;
    background-size: 160px;
    background-repeat: no-repeat;
//======================================//


//======================================//
// Nextblogger
.nextblogger
  padding: 20px 10px 10px;
  .site-author-image
    display: block;
    margin: 0 auto;
    padding: 2px;
    max-width: 120px;
    height: auto;
    border: 1px solid #eee;
    opacity: 1;
    border-radius: 100%;
  .site-author-box
    margin-top: 1rem;
    text-align: center;
    .site-author-name
      font-weight: 600;
      font-size: 1rem;
      color: var(--color-text);
      margin: 0;
    .site-author-description
      color: var(--color-list);
      margin-top: 2px;
      text-align: center;
      font-size: 0.85rem;
  .links-of-author
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
    a
      color: var(--color-list);
      &:hover
        color: #f9a972;
  .links-of-author-item
    margin: 0 4px;
    font-size: 1.05rem;
    color: var(--text-color);
//======================================//
