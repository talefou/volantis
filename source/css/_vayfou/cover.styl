//===========================
//  样式覆盖
//===========================

// 样式修订 HandSome H1 H2 标题
article#post
  h1
    font-family: $fontfamily-logo
  h2
    font-family: $fontfamily-logo
    font-weight 900
    line-height inherit
    background linear-gradient(to bottom, transparent 60%, rgba(189,202,219,.3) 0) no-repeat
    border-bottom none
    display: initial
  h3
    font-family: $fontfamily-logo
    font-weight 900

// 调整移动端的显示
#safearea
  @media screen and (max-width: $device-mobile)
    margin 0 !important
    box-shadow none
    .body-wrapper
      padding 0
    #l_main
      padding-left 0
      article#comments,
      article#friends,
      article#post,
      article#page,
      article#arc      
        border-radius 0
      article#cat,
      article#tag
        margin 0
        border-radius 0
      .post-wrapper
        margin 0 0 16px
        .post
          border-radius 0
    #l_side
      .widget.mobile
        border-radius 0

// <kbd></kbd>
kbd
  background-color #f2f2f2
  color var(--color-p)
  padding 3px 5px
  border-radius 0.25em
  box-shadow inset 0 -2px 0 hsl(240deg 1% 83%), 0 1px 1px rgba(0,0,0,.05)
  font 0.6875rem SFMono-Regular,Consolas,Liberation Mono,Menlo,monospace

// <code></code>
.article code:not([class]) {
    word-break: break-all;
    background: var(--color-codeblock);
    border-radius: 6px;
    font-size: .8125rem;
    padding: 0 .5em;
    margin: 0 .3em;
    overflow-wrap: break-word;
    display: inline-block;
    text-indent: 0
}

// 标签：link 链接居中
.md .tag.link
  text-align center

// 修复侧边栏 list 链接处字体粗细问题
.widget.list .content a > div.name
  font-weight initial

// 江西拙楷：字体修饰
.article-title a
  font-weight 400

// 对 a 链接的样式
li:not([class]) a:not([class]),
p:not([class]) a:not([class]),
table a:not([class]),
.comment-policy-link a
  position relative
  text-decoration none
  padding 0 2px
  border-radius 0
  transition all 0.2s ease-out
  background linear-gradient(0deg, rgba(32,148,243,0.2), rgba(32,148,243,0.2)) no-repeat left 100% / 100% 0
  &:hover
    border-radius 4px
    background linear-gradient(0deg, rgba(32,148,243,0.2), rgba(32,148,243,0.2)) no-repeat left 100% / 100% 100%

// 分隔符
article hr
  background-image: none;
  height: 2em;
  border: none;
  margin: 1em 0 1em;
  text-align: center;
  &:after
    content: "···";
    letter-spacing: 2em;
    padding-left: 2em;
    font-weight: 700;
